---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, NOINDEX } from '../config/site';
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Equivalent paths in both languages, e.g. { sq: '/prona/', en: '/en/properties/' } */
  alternates: Record<Lang, string>;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
  brandMoment?: boolean;
  bodyClass?: string;
}
const { lang, title, description, alternates, ogImage, ogType = 'website', jsonLd, brandMoment = false, bodyClass } = Astro.props;
const t = dict(lang);
const canonical = new URL(alternates[lang], SITE.url).href;
const og = new URL(ogImage ?? '/og-default.jpg', SITE.url).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sq" href={new URL(alternates.sq, SITE.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, SITE.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.sq, SITE.url).href} />
    <link rel="preload" href="/fonts/archivo-latin-wdth.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#285943" />
    <meta property="og:site_name" content="Brikk Estates" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'sq_AL'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'sq_AL' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {brandMoment && (
      <script is:inline>
        try { if (!sessionStorage.getItem('brikk-moment')) { document.documentElement.setAttribute('data-brand-moment', ''); sessionStorage.setItem('brikk-moment', '1'); } } catch (e) {}
      </script>
    )}
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} alternates={alternates} />
    <slot name="after" />
  </body>
</html>
<style>
  main:focus { outline: none; }
</style>
