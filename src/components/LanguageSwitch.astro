---
import { dict, type Lang } from '../i18n';

interface Props { lang: Lang; alternates: Record<Lang, string> }
const { lang, alternates } = Astro.props;
const t = dict(lang);
const options: { code: Lang; short: string; name: string }[] = [
  { code: 'sq', short: 'SQ', name: 'Shqip' },
  { code: 'en', short: 'EN', name: 'English' },
];
---
<ul role="list" class="lang-switch" aria-label={t.nav.langSwitch}>
  {options.map((o) =>
    o.code === lang ? (
      <li><span class="lang-switch__item is-current" aria-current="true"><abbr title={o.name} lang={o.code}>{o.short}</abbr></span></li>
    ) : (
      <li>
        <a class="lang-switch__item" href={alternates[o.code]} hreflang={o.code} lang={o.code}>
          <span aria-hidden="true">{o.short}</span><span class="visually-hidden">{o.name}</span>
        </a>
      </li>
    ),
  )}
</ul>
<style>
  .lang-switch { display: flex; gap: 2px; padding: 3px; border: 1.5px solid rgb(239 232 216 / 0.4); border-radius: var(--radius); }
  .lang-switch__item {
    display: grid; place-items: center; min-width: 40px; min-height: 36px; padding: 0 0.45rem;
    font-size: var(--fs-sm); font-weight: 650; letter-spacing: 0.04em; color: var(--cream); text-decoration: none; border-radius: var(--radius-sm);
  }
  .lang-switch__item abbr { text-decoration: none; }
  .lang-switch__item.is-current { background: var(--cream); color: var(--green-ink); }
  a.lang-switch__item:hover { background: rgb(239 232 216 / 0.12); }
  @media (pointer: coarse) { .lang-switch__item { min-height: 44px; min-width: 44px; } }
</style>
