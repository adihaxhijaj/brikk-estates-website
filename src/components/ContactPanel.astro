---
import Icon from './Icon.astro';
import { SITE } from '../config/site';
import { dict, type Lang } from '../i18n';
import { priceView, title as listingTitle, type Listing } from '../lib/listings';

interface Props {
  listing: Listing;
  lang: Lang;
}
const { listing: l, lang } = Astro.props;
const t = dict(lang);

const pv = priceView(l, lang);
const name = listingTitle(l, lang);
const message = t.detail.whatsappMessage(l.ref, name);
const waHref = `${SITE.whatsapp}?text=${encodeURIComponent(message)}`;
const mailHref = `mailto:${SITE.emailInfo}?subject=${encodeURIComponent(t.detail.emailSubject(l.ref, name))}&body=${encodeURIComponent(message)}`;
---

<aside class="panel" aria-labelledby="ask-heading">
  <p class="panel-ref num">{t.card.ref} {l.ref}</p>

  <p class="panel-price price">
    {pv.onRequest ? <span class="panel-price-req">{t.card.priceOnRequest}</span> : pv.main}
    {pv.sub && <span class="panel-price-sub">{pv.sub}</span>}
  </p>

  <h2 id="ask-heading" class="panel-title">{t.detail.ask}</h2>

  <div class="panel-actions">
    <a class="btn btn-primary" href={`tel:${SITE.phoneE164}`}>
      <Icon name="phone" size={18} />
      {t.detail.call}
    </a>
    <a class="btn btn-outline" href={waHref} rel="noopener">
      <Icon name="message-circle" size={18} />
      {t.detail.whatsapp}
    </a>
    <a class="btn btn-outline" href={SITE.viber}>
      <Icon name="phone-call" size={18} />
      {t.detail.viber}
    </a>
    <a class="btn btn-outline" href={mailHref}>
      <Icon name="mail" size={18} />
      {t.detail.email}
    </a>
  </div>

  <p class="panel-phone">
    <a href={`tel:${SITE.phoneE164}`}>{SITE.phoneDisplay}</a>
    <span class="note">{t.detail.viberNote}</span>
  </p>

  <div class="panel-share">
    <button class="panel-share-btn" type="button" data-share data-url={Astro.url.pathname} data-title={name}>
      <Icon name="share-2" size={17} />
      <span data-share-label>{t.detail.share}</span>
    </button>
    <span class="sr-only" role="status" data-share-status></span>
  </div>
</aside>

<style>
  .panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    padding: var(--s-5);
  }
  .panel-ref {
    font-size: var(--step--1);
    color: var(--ink-3);
    letter-spacing: 0.04em;
    margin: 0;
  }
  .panel-price {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-block: var(--s-1) var(--s-4);
  }
  .panel-price-req {
    font-size: var(--step-1);
    color: var(--ink-2);
  }
  .panel-price-sub {
    display: block;
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--ink-3);
    letter-spacing: 0;
  }
  .panel-title {
    font-size: var(--step-0);
    font-weight: 600;
    font-variation-settings: 'wdth' 100;
    color: var(--ink-2);
    margin-block-end: var(--s-3);
  }
  .panel-actions {
    display: grid;
    gap: var(--s-2);
  }
  .panel-phone {
    margin-block-start: var(--s-4);
    display: grid;
    gap: var(--s-1);
    font-weight: 600;
  }
  .panel-phone a {
    text-decoration: none;
  }
  .panel-phone .note {
    font-weight: 400;
  }
  .panel-share {
    margin-block-start: var(--s-4);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--line);
  }
  .panel-share-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }
  .panel-share-btn:hover {
    color: var(--ink);
  }
</style>

<script>
  import { dict } from '../i18n';

  const btn = document.querySelector<HTMLButtonElement>('[data-share]');
  const label = document.querySelector<HTMLElement>('[data-share-label]');
  const status = document.querySelector<HTMLElement>('[data-share-status]');

  if (btn && label) {
    const t = dict(document.documentElement.lang === 'en' ? 'en' : 'sq');
    const canShare = typeof navigator.share === 'function';

    // Honest label: without the Share API this button copies a link, so say so.
    if (!canShare) label.textContent = t.detail.copyLink;

    const say = (msg: string) => {
      label.textContent = msg;
      if (status) status.textContent = msg;
      setTimeout(() => {
        label.textContent = canShare ? t.detail.share : t.detail.copyLink;
      }, 3000);
    };

    btn.addEventListener('click', async () => {
      const url = location.href;
      if (canShare) {
        try {
          await navigator.share({ title: btn.dataset.title ?? document.title, url });
          return;
        } catch {
          /* dismissed, or unavailable: fall through to copying */
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        say(t.detail.copied);
      } catch {
        say(t.detail.copyFailed);
      }
    });
  }
</script>
