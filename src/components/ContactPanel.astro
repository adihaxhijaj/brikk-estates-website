---
import Icon from './Icon.astro';
import { SITE } from '../config/site';
import { dict, type Lang } from '../i18n';
import { dealLabel, priceView, title, type Listing } from '../lib/listings';

interface Props { listing: Listing; lang: Lang; url: string }
const { listing: l, lang, url } = Astro.props;
const t = dict(lang);
const name = title(l, lang);
const summary = [name, l.complex].filter(Boolean).join(', ');
const wa = `${SITE.whatsapp}?text=${encodeURIComponent(t.detail.whatsappMessage(l.ref, summary))}`;
const mail = `mailto:${SITE.emailProperties}?subject=${encodeURIComponent(t.detail.emailSubject(l.ref, name))}`;
const pv = priceView(l, lang);
---
<aside class="contact-panel" aria-labelledby="contact-panel-title">
  <div class="contact-panel__head">
    <span class:list={['badge', l.deal === 'sale' ? 'badge--sale' : 'badge--rent']}>{dealLabel(l, lang)}</span>
    <span class="ref">{t.card.ref} {l.ref}</span>
  </div>
  <p class="contact-panel__price tabular">
    {pv.onRequest ? t.card.priceOnRequest : <>{pv.main}{pv.sub && <span class="contact-panel__sub"> {pv.sub}</span>}</>}
  </p>
  <h2 id="contact-panel-title" class="contact-panel__title">{t.detail.ask}</h2>
  <ul role="list" class="contact-panel__actions">
    <li><a class="btn btn--block" href={`tel:${SITE.phoneE164}`}><Icon name="phone" />{t.detail.call}</a></li>
    <li><a class="btn btn--block" href={wa}><Icon name="message-circle" />{t.detail.whatsapp}</a></li>
    <li><a class="btn btn--outline btn--block" href={SITE.viber}><Icon name="phone-call" />{t.detail.viber}</a></li>
    <li><a class="btn btn--outline btn--block" href={mail}><Icon name="mail" />{t.detail.email}</a></li>
  </ul>
  <p class="contact-panel__phone">
    <span class="tabular">{SITE.phoneDisplay}</span>
    <span class="contact-panel__note">{t.detail.viberNote}</span>
  </p>
  <div class="contact-panel__share">
    <button type="button" class="btn btn--outline btn--block" data-share data-url={url} data-title={`${name} · Ref ${l.ref}`} data-copy-label={t.detail.copyLink} data-ok={t.detail.copied} data-fail={t.detail.copyFailed} data-status="share-status" hidden>
      <Icon name="share-2" /><span data-label>{t.detail.share}</span>
    </button>
    <p id="share-status" class="contact-panel__status" role="status" aria-live="polite"></p>
  </div>
</aside>

<div class="action-bar" data-action-bar>
  <a class="btn" href={`tel:${SITE.phoneE164}`}><Icon name="phone" />{t.detail.call}</a>
  <a class="btn btn--cream" href={wa}><Icon name="message-circle" />{t.detail.whatsapp}</a>
</div>

<script>
  import '../scripts/copy-share';
</script>

<style>
  .contact-panel { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: var(--s-5); display: grid; gap: var(--s-3); }
  .contact-panel__head { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); }
  .contact-panel__price { font-size: var(--fs-lg); font-weight: 780; font-stretch: 110%; line-height: 1.2; }
  .contact-panel__sub { font-size: var(--fs-sm); font-weight: 500; color: var(--muted); font-stretch: 100%; }
  .contact-panel__title { font-size: var(--fs-md); margin-top: var(--s-2); }
  .contact-panel { min-width: 0; }
  .contact-panel__actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr)); gap: var(--s-2); }
  .contact-panel__actions .btn { padding-inline: 0.6rem; }
  .contact-panel__phone { display: grid; gap: 2px; font-weight: 650; }
  .contact-panel__note { font-weight: 450; font-size: var(--fs-sm); color: var(--muted); }
  .contact-panel__status { font-size: var(--fs-sm); color: var(--green-ink); min-height: 1.4em; margin-top: var(--s-1); }

  .action-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-2);
    padding: var(--s-2) var(--gutter) calc(var(--s-2) + env(safe-area-inset-bottom));
    background: var(--green); box-shadow: 0 -6px 20px rgb(0 0 0 / 0.18);
  }
  .action-bar .btn { min-height: 48px; }
  .action-bar .btn:not(.btn--cream) { --btn-bg: var(--green-deep); --btn-bd: rgb(239 232 216 / 0.55); --btn-fg: var(--cream); }
  :global(body.has-action-bar) { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
  @media (min-width: 62rem) {
    .action-bar { display: none; }
    :global(body.has-action-bar) { padding-bottom: 0; }
  }
</style>
