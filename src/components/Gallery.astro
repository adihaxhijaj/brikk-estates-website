---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { dict, type Lang } from '../i18n';
import type { Listing } from '../lib/listings';

interface Props {
  listing: Listing;
  lang: Lang;
}
const { listing: l, lang } = Astro.props;
const t = dict(lang);

// Cover first, then the rest in source order. Overlay graphics keep their place at the end.
const ordered = [l.images[l.coverIndex], ...l.images.filter((_, i) => i !== l.coverIndex)].filter(Boolean);
const alt = (img: (typeof ordered)[number]) => (lang === 'en' ? img.altEn : img.altSq);
const n = ordered.length;
---

<section class="gal" aria-label={t.detail.gallery}>
  <figure class="gal-main">
    <Image
      src={ordered[0].src}
      alt={alt(ordered[0])}
      widths={[720, 1080, 1600]}
      sizes="(min-width: 1100px) 62vw, 100vw"
      width={1200}
      height={900}
      loading="eager"
      fetchpriority="high"
    />
    <button class="gal-open" type="button" data-gal-open="0">
      <Icon name="maximize-2" size={17} />
      {t.detail.showAllPhotos(n)}
    </button>
  </figure>

  {
    n > 1 && (
      <ul class="gal-thumbs">
        {ordered.slice(1).map((img, i) => (
          <li>
            <button type="button" data-gal-open={String(i + 1)} aria-label={t.detail.photo(i + 2, n)}>
              <Image src={img.src} alt="" widths={[160, 320]} sizes="160px" width={320} height={240} loading="lazy" />
            </button>
          </li>
        ))}
      </ul>
    )
  }

  <dialog class="lb" data-lightbox aria-label={t.detail.gallery}>
    <div class="lb-bar">
      <p class="lb-count num" data-lb-count aria-live="polite"></p>
      <button class="lb-btn" type="button" data-lb-close aria-label={t.detail.close}>
        <Icon name="x" size={22} />
      </button>
    </div>

    <div class="lb-stage" data-lb-stage>
      {
        ordered.map((img, i) => (
          <figure class="lb-slide" data-lb-slide={String(i)} hidden={i !== 0}>
            {/* The photo's own proportions: with a fixed 4:3 box the image service crops every size,
                cutting the edges off floor plans and portrait photos in the full-screen view. */}
            <Image
              src={img.src}
              alt={alt(img)}
              widths={[900, 1400, 2000]}
              sizes="100vw"
              width={img.width}
              height={img.height}
              loading="lazy"
            />
          </figure>
        ))
      }
    </div>

    {
      n > 1 && (
        <>
          <button class="lb-btn lb-prev" type="button" data-lb-prev aria-label={t.detail.prev}>
            <Icon name="chevron-left" size={26} />
          </button>
          <button class="lb-btn lb-next" type="button" data-lb-next aria-label={t.detail.next}>
            <Icon name="chevron-right" size={26} />
          </button>
        </>
      )
    }
  </dialog>
</section>

<style>
  .gal {
    display: grid;
    gap: var(--s-2);
  }
  .gal-main {
    position: relative;
    margin: 0;
    border-radius: var(--r-3);
    overflow: hidden;
    background: var(--surface-2);
  }
  .gal-main :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .gal-open {
    position: absolute;
    inset-block-end: var(--s-3);
    inset-inline-end: var(--s-3);
    display: none;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 0 var(--s-4);
    background: #fffffff2;
    color: var(--ink);
    border-radius: var(--r-2);
    font-size: var(--step--1);
    font-weight: 600;
    box-shadow: 0 2px 10px -4px #00000059;
  }
  :global(html.js) .gal-open {
    display: inline-flex;
  }

  .gal-thumbs {
    display: grid;
    grid-auto-flow: column;
    /* Fixed width so two thumbnails never stretch to half the page. */
    grid-auto-columns: 116px;
    justify-content: start;
    gap: var(--s-2);
    overflow-x: auto;
    list-style: none;
    margin: 0;
    padding: 0 0 var(--s-2);
    scrollbar-width: thin;
  }
  .gal-thumbs button {
    display: block;
    width: 100%;
    border-radius: var(--r-2);
    overflow: hidden;
    background: var(--surface-2);
  }
  .gal-thumbs :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity var(--t) var(--ease);
  }
  .gal-thumbs button:hover :global(img) {
    opacity: 0.82;
  }

  /* ---- Lightbox ---- */
  .lb {
    border: 0;
    padding: 0;
    width: 100%;
    max-width: 100vw;
    height: 100%;
    max-height: 100dvh;
    background: #0d1613;
    color: var(--cream);
  }
  .lb::backdrop {
    background: #0d1613e6;
  }
  .lb-bar {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    padding-block-start: max(var(--s-3), env(safe-area-inset-top));
  }
  .lb-count {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .lb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    color: var(--cream);
    background: #ffffff1f;
  }
  .lb-btn:hover {
    background: #ffffff33;
  }
  .lb-prev,
  .lb-next {
    position: absolute;
    inset-block-start: 50%;
    translate: 0 -50%;
    z-index: 2;
  }
  .lb-prev {
    inset-inline-start: var(--s-3);
  }
  .lb-next {
    inset-inline-end: var(--s-3);
  }

  .lb-stage {
    height: 100%;
    display: grid;
    place-items: center;
    padding: calc(var(--s-8)) var(--s-3);
  }
  .lb-slide {
    margin: 0;
  }
  .lb-slide :global(img) {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const stage = document.querySelector<HTMLElement>('[data-lb-stage]');
  const countEl = document.querySelector<HTMLElement>('[data-lb-count]');

  if (dialog && stage) {
    const slides = [...stage.querySelectorAll<HTMLElement>('[data-lb-slide]')];
    const total = slides.length;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + total) % total;
      slides.forEach((s, n) => (s.hidden = n !== index));
      if (countEl) countEl.textContent = `${index + 1} / ${total}`;
    };

    for (const btn of document.querySelectorAll<HTMLElement>('[data-gal-open]')) {
      btn.addEventListener('click', () => {
        opener = btn;
        show(Number(btn.dataset.galOpen ?? 0));
        dialog.showModal();
      });
    }

    /**
     * Close and hand focus back to whatever opened the gallery.
     *
     * The `close` event would be the tidy place for this, but it cannot be relied on — some
     * engines do not fire it, which silently leaves focus stranded inside a closed dialog. So
     * every path that closes restores focus itself; `focus()` is idempotent, so the `close`
     * listener below is harmless belt-and-braces where the event does arrive.
     */
    const dismiss = () => {
      dialog.close();
      opener?.focus();
    };

    document.querySelector('[data-lb-close]')?.addEventListener('click', dismiss);
    document.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    document.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(index + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(index - 1);
      }
    });

    // Escape is handled natively by <dialog>; `cancel` fires just before it closes.
    dialog.addEventListener('cancel', () => setTimeout(() => opener?.focus(), 0));
    dialog.addEventListener('close', () => opener?.focus());

    // Swipe.
    let x0: number | null = null;
    stage.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    stage.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 45) show(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });

    // Clicking the backdrop closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dismiss();
    });
  }
</script>
