---
// Listing gallery. Without JS: a mosaic plus a <details> list of every photo (each links to a large version).
// With JS (src/scripts/gallery.ts): an accessible lightbox with arrows, swipe, Escape, focus return and "3 / 10" counter.
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { dict, type Lang } from '../i18n';
import type { Listing } from '../lib/listings';

interface Props { listing: Listing; lang: Lang }
const { listing: l, lang } = Astro.props;
const t = dict(lang);
// Cover first, remaining images in import order.
const ordered = [l.images[l.coverIndex], ...l.images.filter((_, i) => i !== l.coverIndex)];
const large = await Promise.all(ordered.map((img) => getImage({ src: img.src, width: Math.min(1800, img.width), format: 'webp', quality: 80 })));
const alt = (img: (typeof ordered)[number]) => (lang === 'en' ? img.altEn : img.altSq);
const n = ordered.length;
const mosaic = ordered.slice(0, 5);
---
<section class="gallery" aria-label={t.detail.gallery} data-gallery>
  <ul role="list" class:list={['gallery__mosaic', `gallery__mosaic--${Math.min(n, 5)}`]}>
    {mosaic.map((img, i) => (
      <li class="gallery__cell">
        <a href={large[i].src} class="gallery__link" data-index={i} aria-label={`${t.detail.photo(i + 1, n)}: ${alt(img)}`}>
          <Picture
            src={img.src}
            alt=""
            formats={['avif', 'webp']}
            widths={i === 0 ? [640, 960, 1280, 1600] : [360, 560, 800]}
            sizes={i === 0 ? '(min-width: 75rem) 52rem, 100vw' : '(min-width: 75rem) 26rem, 50vw'}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </a>
      </li>
    ))}
  </ul>
  <button type="button" class="btn btn--cream gallery__all" data-open-gallery hidden><Icon name="images" />{t.detail.showAllPhotos(n)}</button>
  <details class="gallery__nojs" data-nojs-list>
    <summary class="btn btn--outline">{t.detail.showAllPhotos(n)}</summary>
    <ul role="list" class="gallery__thumbs">
      {ordered.map((img, i) => (
        <li><a href={large[i].src}><Picture src={img.src} alt={alt(img)} formats={['webp']} widths={[320, 480]} sizes="(min-width: 48rem) 20vw, 45vw" loading="lazy" /></a></li>
      ))}
    </ul>
  </details>

  <dialog class="lightbox" aria-label={t.detail.gallery} data-lightbox>
    <div class="lightbox__bar">
      <p class="lightbox__counter tabular" aria-live="polite" data-counter></p>
      <button type="button" class="lightbox__btn" data-close aria-label={t.detail.close}><Icon name="x" size={26} /></button>
    </div>
    <figure class="lightbox__stage" data-stage>
      <img alt="" data-img decoding="async" />
      <figcaption class="visually-hidden" data-caption></figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--prev" data-prev aria-label={t.detail.prev}><Icon name="chevron-left" size={30} /></button>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--next" data-next aria-label={t.detail.next}><Icon name="chevron-right" size={30} /></button>
    <script type="application/json" data-images set:html={JSON.stringify(ordered.map((img, i) => ({ src: large[i].src, w: large[i].attributes.width, h: large[i].attributes.height, alt: alt(img) })))} />
    <template data-counter-template>{t.detail.photo(111, 222)}</template>
  </dialog>
</section>

<script>
  import '../scripts/gallery';
</script>

<style>
  .gallery { position: relative; }
  .gallery__mosaic { display: grid; gap: 4px; border-radius: var(--radius-lg); overflow: hidden; background: var(--cream-soft); }
  .gallery__cell { min-width: 0; min-height: 0; }
  .gallery__link { display: block; height: 100%; }
  .gallery__link :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .gallery__link:focus-visible { outline-offset: -4px; outline-color: var(--white); box-shadow: inset 0 0 0 7px var(--green); }
  .gallery__cell:first-child { aspect-ratio: 4 / 3; }
  .gallery__cell:not(:first-child) { display: none; }
  @media (min-width: 48rem) {
    .gallery__mosaic--3, .gallery__mosaic--4, .gallery__mosaic--5 { grid-template-columns: 2fr 1fr; aspect-ratio: 16 / 8.5; }
    .gallery__mosaic--2 { grid-template-columns: 1fr 1fr; aspect-ratio: 16 / 6; }
    .gallery__cell:not(:first-child) { display: block; }
    .gallery__mosaic--2 .gallery__cell:first-child, .gallery__mosaic--3 .gallery__cell:first-child, .gallery__mosaic--4 .gallery__cell:first-child, .gallery__mosaic--5 .gallery__cell:first-child { aspect-ratio: auto; }
    .gallery__mosaic--3 .gallery__cell:first-child, .gallery__mosaic--4 .gallery__cell:first-child, .gallery__mosaic--5 .gallery__cell:first-child { grid-row: span 2; }
    .gallery__mosaic--4 .gallery__cell:nth-child(n + 4), .gallery__mosaic--5 .gallery__cell:nth-child(n + 4) { display: none; }
  }
  @media (min-width: 75rem) {
    .gallery__mosaic--5 { grid-template-columns: 2fr 1fr 1fr; }
    .gallery__mosaic--5 .gallery__cell:nth-child(n + 4) { display: block; }
    .gallery__mosaic--4 { grid-template-columns: 2fr 1fr 1fr; }
    .gallery__mosaic--4 .gallery__cell:nth-child(n + 4) { display: block; }
    .gallery__mosaic--4 .gallery__cell:nth-child(2) { grid-row: span 2; }
  }
  .gallery__all { position: absolute; right: var(--s-3); bottom: var(--s-3); box-shadow: var(--shadow); }
  .gallery__nojs { margin-top: var(--s-3); }
  .gallery__nojs summary { list-style: none; }
  .gallery__nojs summary::-webkit-details-marker { display: none; }
  .gallery__thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: var(--s-2); margin-top: var(--s-3); }
  .gallery__thumbs :global(img) { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; border-radius: var(--radius-sm); }
  :global(.js-gallery) .gallery__nojs { display: none; }

  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #0e1411; color: var(--white); overflow: hidden; }
  .lightbox[open] { display: grid; grid-template-rows: auto 1fr; }
  .lightbox::backdrop { background: #0e1411; }
  .lightbox__bar { display: flex; align-items: center; justify-content: space-between; padding: max(var(--s-2), env(safe-area-inset-top)) var(--s-3) var(--s-2) var(--s-4); }
  .lightbox__counter { font-weight: 600; }
  .lightbox__stage { display: grid; place-items: center; min-height: 0; padding: 0 var(--s-2) max(var(--s-3), env(safe-area-inset-bottom)); touch-action: pan-y pinch-zoom; }
  .lightbox__stage img { max-width: 100%; max-height: 100%; object-fit: contain; user-select: none; -webkit-user-drag: none; }
  .lightbox__btn { display: grid; place-items: center; width: 48px; height: 48px; border: 0; border-radius: 999px; background: rgb(255 255 255 / 0.1); color: var(--white); }
  .lightbox__btn:hover { background: rgb(255 255 255 / 0.2); }
  .lightbox__btn:focus-visible { outline: 3px solid var(--leaf); outline-offset: 2px; }
  .lightbox__nav { position: absolute; top: 50%; translate: 0 -50%; }
  .lightbox__nav--prev { left: var(--s-3); }
  .lightbox__nav--next { right: var(--s-3); }
  @media (max-width: 47.99rem) { .lightbox__nav { top: auto; bottom: max(var(--s-4), env(safe-area-inset-bottom)); translate: none; background: rgb(0 0 0 / 0.55); } }
</style>
