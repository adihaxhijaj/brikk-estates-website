---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../config/site';
import { dict, route, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict(lang);
const other: Lang = lang === 'en' ? 'sq' : 'en';
const year = new Date().getFullYear();

// The footer carries the full map, including the category pages the header no longer lists.
const pages = [
  { key: 'properties', label: t.footer.all },
  { key: 'sale', label: t.nav.sale },
  { key: 'rent', label: t.nav.rent },
  { key: 'land', label: t.nav.land },
  { key: 'newBuilds', label: t.nav.newBuilds },
  { key: 'request', label: t.nav.request },
  { key: 'owners', label: t.nav.owners },
  { key: 'wanted', label: t.footer.wanted },
  { key: 'about', label: t.nav.about },
  { key: 'contact', label: t.nav.contact },
] as const;

const legal = [
  { key: 'terms', label: t.footer.terms },
  { key: 'privacy', label: t.footer.privacy },
] as const;
---

<footer class="ftr on-green">
  <div class="wrap ftr-in">
    <div class="ftr-brand">
      <a href={route('home', lang)} aria-label={t.nav.home}>
        <Logo variant="stacked" tone="light" width={132} />
      </a>
      <p class="ftr-tagline">{t.tagline}</p>
    </div>

    <nav class="ftr-nav" aria-label={t.footer.navTitle}>
      <h2>{t.footer.navTitle}</h2>
      <ul>
        {
          pages.map((p) => (
            <li>
              <a href={route(p.key, lang)}>{p.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ftr-contact">
      <h2>{t.footer.contactTitle}</h2>
      <ul>
        <li>
          <a href={`tel:${SITE.phoneE164}`}>
            <Icon name="phone" size={17} />{SITE.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.emailInfo}`}>
            <Icon name="mail" size={17} />{SITE.emailInfo}
          </a>
        </li>
        <li>
          <a href={SITE.instagram} rel="me noopener">
            <Icon name="camera" size={17} />{SITE.instagramHandle}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap ftr-base">
    <p>{t.footer.rights(year)}</p>
    <nav class="ftr-legal" aria-label={t.footer.legalTitle}>
      {legal.map((l) => <a href={route(l.key, lang)}>{l.label}</a>)}
      <a href={route('home', other)} lang={other === 'en' ? 'en' : 'sq'}>{t.otherLangLabel}</a>
    </nav>
  </div>
</footer>

<style>
  .ftr {
    padding-block: var(--s-8) var(--s-5);
    margin-block-start: var(--s-7);
  }
  .ftr-in {
    display: grid;
    gap: var(--s-7) var(--s-6);
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    align-items: start;
  }
  .ftr-brand {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .ftr-tagline {
    font-size: var(--step-1);
    font-variation-settings: 'wdth' var(--wide);
    color: var(--cream);
    max-width: 22ch;
    line-height: 1.25;
  }

  .ftr h2 {
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--leaf-text);
    font-variation-settings: 'wdth' 100;
    margin-block-end: var(--s-4);
  }
  .ftr ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-1);
  }
  .ftr a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding-block: var(--s-2);
    text-decoration: none;
    color: var(--on-green-2);
  }
  .ftr a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .ftr-base {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    justify-content: space-between;
    align-items: center;
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--on-green-line);
    font-size: var(--step--1);
    color: var(--on-green-2);
  }
  .ftr-base p {
    margin: 0;
  }
  .ftr-legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }
  .ftr-legal a {
    padding-block: var(--s-2);
  }
</style>
