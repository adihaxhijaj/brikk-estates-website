---
/**
 * The ONLY place the Brikk Estates identity is drawn.
 *
 * The artwork is the agency's OFFICIAL vector artwork, extracted from `Brikk Estates.ai` into
 * `src/assets/brand/logo-parts.json`. These are the real curves and the file's own colours —
 * not a trace, not a reconstruction. (The extraction script and the .ai source are not part of
 * this project.)
 *
 * After a brand revision: replace logo-parts.json (same shape: colours, symbol, lockup), then
 * replace the favicons and og-default.jpg in `public/`.
 */
import parts from '../assets/brand/logo-parts.json';

interface Props {
  variant?: 'horizontal' | 'stacked' | 'symbol';
  /** 'light' = leaf symbol + cream wordmark, for deep-green surfaces.
   *  'dark'  = brand green throughout, for light surfaces. */
  tone?: 'light' | 'dark';
  /** Rendered width in px; height follows the artwork's own aspect ratio. */
  width?: number;
  title?: string | null;
  class?: string;
}

const { variant = 'horizontal', tone = 'light', width = 180, title = null, class: cls = '' } = Astro.props;

const sym = parts.symbol as { viewBox: number[]; paths: string[] };
const lock = parts.lockup as {
  viewBox: number[];
  symbol: string[];
  wordmark: string[];
  symbolBox: { x: number; y: number; w: number; h: number };
  wordmarkBox: { x: number; y: number; w: number; h: number };
};

const symbolFill = tone === 'light' ? parts.colours.leaf : parts.colours.green;
const wordFill = tone === 'light' ? parts.colours.cream : parts.colours.green;

let viewBox: string;
let height: number;

if (variant === 'symbol') {
  viewBox = sym.viewBox.join(' ');
  height = Math.round((width * sym.viewBox[3]) / sym.viewBox[2]);
} else if (variant === 'horizontal') {
  viewBox = lock.viewBox.join(' ');
  height = Math.round((width * lock.viewBox[3]) / lock.viewBox[2]);
} else {
  viewBox = '';
  height = 0;
}

// ---- Stacked lockup, composed from the same artwork ----
// The wordmark sets the width; the symbol sits centred above it, with clear space of roughly
// one house piece between the two.
const wb = lock.wordmarkBox;
const sScale = (wb.w * 0.34) / lock.symbolBox.w;
const symW = lock.symbolBox.w * sScale;
const symH = lock.symbolBox.h * sScale;
const gap = symH * 0.22;
const stackedW = wb.w;
const stackedH = symH + gap + wb.h;

if (variant === 'stacked') {
  viewBox = `0 0 ${stackedW} ${stackedH}`;
  height = Math.round((width * stackedH) / stackedW);
}

const a11y: Record<string, string> = title
  ? { role: 'img', 'aria-label': title }
  : { 'aria-hidden': 'true', role: 'presentation' };
---

<svg
  width={width}
  height={height}
  viewBox={viewBox}
  xmlns="http://www.w3.org/2000/svg"
  class={cls}
  focusable="false"
  {...a11y}
>
  {
    variant === 'symbol' && (
      <g fill={symbolFill}>
        {sym.paths.map((d) => (
          <path d={d} />
        ))}
      </g>
    )
  }

  {
    variant === 'horizontal' && (
      <>
        <g fill={symbolFill}>
          {lock.symbol.map((d) => (
            <path d={d} />
          ))}
        </g>
        <g fill={wordFill}>
          {lock.wordmark.map((d) => (
            <path d={d} />
          ))}
        </g>
      </>
    )
  }

  {
    variant === 'stacked' && (
      <>
        <g fill={symbolFill} transform={`translate(${(stackedW - symW) / 2} 0) scale(${sScale}) translate(${-lock.symbolBox.x} ${-lock.symbolBox.y})`}>
          {lock.symbol.map((d) => (
            <path d={d} />
          ))}
        </g>
        <g fill={wordFill} transform={`translate(${-wb.x} ${symH + gap - wb.y})`}>
          {lock.wordmark.map((d) => (
            <path d={d} />
          ))}
        </g>
      </>
    )
  }
</svg>
