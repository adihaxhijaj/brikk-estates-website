---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../config/site';
import { dict, route, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
  altPath: string;
}
const { lang, path, altPath } = Astro.props;
const t = dict(lang);
const other: Lang = lang === 'en' ? 'sq' : 'en';

// One entry for the whole catalogue — the filters on /prona/ do the dividing that the old
// Shitje / Qira / Toka / Ndërtime entries used to. Those pages still exist and are linked
// from the footer and from the home search panel.
const nav = [
  { key: 'properties', label: t.nav.properties },
  { key: 'owners', label: t.nav.owners },
  { key: 'about', label: t.nav.about },
  { key: 'contact', label: t.nav.contact },
] as const;

const isCurrent = (href: string) => path === href;
---

<header class="hdr">
  <div class="wrap hdr-in">
    <a class="hdr-logo" href={route('home', lang)} aria-label={t.nav.home}>
      <Logo variant="symbol" tone="light" width={40} />
    </a>

    <nav class="hdr-nav" aria-label={t.nav.label}>
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={route(n.key, lang)} aria-current={isCurrent(route(n.key, lang)) ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr-end">
      {/* Replaces the phone number: the people who cannot find what they want get somewhere to go. */}
      <a class="hdr-cta" href={route('request', lang)}>
        <Icon name="pen-line" size={17} />
        <span>{t.nav.request}</span>
      </a>

      <a class="hdr-call-icon" href={`tel:${SITE.phoneE164}`} aria-label={t.nav.call}>
        <Icon name="phone" size={20} />
      </a>

      <div class="langsw" role="group" aria-label={t.nav.langSwitch}>
        <a href={path} lang={t.htmlLang} aria-current="true">{lang === 'en' ? 'EN' : 'SQ'}</a>
        <span aria-hidden="true">/</span>
        <a href={altPath} lang={other === 'en' ? 'en' : 'sq'}>{other === 'en' ? 'EN' : 'SQ'}</a>
      </div>

      <button
        class="hdr-menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={t.nav.menu}
        data-menu-toggle
      >
        <Icon name="menu" size={20} />
        <span>{t.nav.menu}</span>
      </button>
    </div>
  </div>

  <!-- Without JavaScript this panel simply stays open below the header, so the site stays navigable
       on a phone. The inline `html.js` flag in Base.astro lets CSS collapse it when JS is available. -->
  <div class="hdr-panel" id="site-menu">
    <div class="wrap">
      <nav aria-label={t.nav.label}>
        <ul>
          {
            nav.map((n) => (
              <li>
                <a href={route(n.key, lang)} aria-current={isCurrent(route(n.key, lang)) ? 'page' : undefined}>
                  {n.label}
                </a>
              </li>
            ))
          }
          {/* The categories that left the bar stay reachable here. */}
          <li><a href={route('sale', lang)}>{t.nav.sale}</a></li>
          <li><a href={route('rent', lang)}>{t.nav.rent}</a></li>
          <li><a href={route('land', lang)}>{t.nav.land}</a></li>
          <li><a href={route('newBuilds', lang)}>{t.nav.newBuilds}</a></li>
          <li><a href={route('wanted', lang)}>{t.footer.wanted}</a></li>
        </ul>
      </nav>
      <div class="hdr-panel-foot">
        <a class="btn btn-cream" href={route('request', lang)}>
          <Icon name="pen-line" size={18} />
          {t.nav.request}
        </a>
        <a class="btn btn-ghost-light" href={`tel:${SITE.phoneE164}`}>
          <Icon name="phone" size={18} />
          {SITE.phoneDisplay}
        </a>
        <a class="btn btn-ghost-light" href={altPath} lang={other === 'en' ? 'en' : 'sq'}>{t.otherLangLabel}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--green-500);
    color: var(--on-green);
  }
  .hdr-in {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }
  .hdr-logo {
    display: flex;
    align-items: center;
    padding-block: var(--s-3);
    flex: none;
    min-width: 0;
  }
  /* Symbol only in the bar — the wordmark lives in the footer and on the OG image. */
  .hdr-logo :global(svg) {
    width: clamp(32px, 9vw, 40px);
    height: auto;
  }

  .hdr-nav {
    margin-inline-start: auto;
  }
  .hdr-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 0.1rem + 1vw, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hdr-nav a {
    display: inline-block;
    padding: var(--s-2) 0;
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    color: var(--on-green);
    border-block-end: 2px solid transparent;
    transition: color var(--t) var(--ease), border-color var(--t) var(--ease);
    white-space: nowrap;
  }
  .hdr-nav a:hover {
    color: #fff;
    border-block-end-color: var(--leaf);
  }
  .hdr-nav a[aria-current='page'] {
    border-block-end-color: var(--leaf);
    color: #fff;
  }

  .hdr-end {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin-inline-start: auto;
    flex: none;
  }
  .hdr-nav + .hdr-end {
    margin-inline-start: 0;
  }

  .hdr-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 40px;
    padding: 0 var(--s-4);
    border-radius: var(--r-2);
    background: var(--cream);
    color: var(--green-700);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--t) var(--ease);
  }
  .hdr-cta:hover {
    background: #fff;
  }

  .hdr-call-icon {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-2);
    border: 1px solid var(--on-green-line);
  }

  .langsw {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .langsw a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    min-height: 30px;
    text-decoration: none;
    color: var(--on-green-2);
    border-radius: var(--r-1);
  }
  .langsw a:hover {
    color: #fff;
  }
  .langsw a[aria-current='true'] {
    color: var(--cream);
    text-decoration: underline;
    text-decoration-color: var(--leaf);
    text-decoration-thickness: 2px;
  }
  .langsw span {
    color: #ffffff59;
  }

  .hdr-menu-btn {
    display: none;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 0 var(--s-3);
    border: 1px solid var(--on-green-line);
    border-radius: var(--r-2);
    color: var(--on-green);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .hdr-panel {
    border-block-start: 1px solid var(--on-green-line);
    background: var(--green-600);
    padding-block: var(--s-4) var(--s-5);
  }
  .hdr-panel ul {
    list-style: none;
    margin: 0 0 var(--s-4);
    padding: 0;
  }
  .hdr-panel li + li {
    border-block-start: 1px solid var(--on-green-line);
  }
  .hdr-panel a {
    display: block;
    padding: var(--s-3) 0;
    min-height: 44px;
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }
  .hdr-panel-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .hdr-panel-foot .btn {
    flex: 1 1 auto;
  }

  /* Narrow phones: tighten every gap and reduce the menu button to its icon. */
  @media (max-width: 560px) {
    .hdr-in {
      gap: var(--s-2);
    }
    .hdr-end {
      gap: var(--s-2);
    }
    .hdr-menu-btn {
      width: 44px;
      padding: 0;
      justify-content: center;
    }
    .hdr-menu-btn span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (max-width: 1100px) {
    .hdr-nav {
      display: none;
    }
    .hdr-call-icon {
      display: inline-flex;
    }
    /* The toggle only appears when it can actually do something. */
    :global(html.js) .hdr-menu-btn {
      display: inline-flex;
    }
    :global(html.js) .hdr-panel {
      display: none;
    }
    :global(html.js) .hdr-panel.is-open {
      display: block;
    }
  }
  @media (min-width: 1101px) {
    .hdr-panel {
      display: none;
    }
  }

  /*
   * Narrow phones, last so it wins over the 1100px rules above. The bar keeps only what
   * matters — mark, the request CTA, and the menu. Calling and the language switch both sit
   * inside the panel, one tap away.
   */
  @media (max-width: 560px) {
    .hdr-call-icon,
    .langsw {
      display: none;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('site-menu');

  if (btn && panel) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('is-open', open);
    };

    setOpen(false);

    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));

    // Close on selection, and on Escape with focus returned to the toggle.
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>
