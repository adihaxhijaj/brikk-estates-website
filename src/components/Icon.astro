---
/**
 * Thin-line functional icons from lucide-static (ISC). Used only for specs and controls,
 * never as decoration. Inlined at build time so no icon font or runtime request is needed.
 */
const files = import.meta.glob('/node_modules/lucide-static/icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

interface Props {
  name: string;
  size?: number;
  stroke?: number;
  class?: string;
  label?: string | null;
}
const { name, size = 20, stroke = 1.6, class: cls = '', label = null } = Astro.props;

const raw = files[`/node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Icon "${name}" not found in lucide-static.`);

const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim();
const a11y = label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"';
const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${stroke}" stroke-linecap="round" stroke-linejoin="round" class="icon ${cls}" ${a11y}>${inner}</svg>`;
---

<Fragment set:html={svg} />

<style is:global>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.16em;
  }
</style>
