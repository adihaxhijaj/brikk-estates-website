---
/**
 * Filter + sort controls. State lives in the URL query string so results are shareable and the
 * back button works. Without JavaScript the controls still submit as a plain GET form, and the
 * server-rendered list for the category stays fully visible either way.
 */
import Icon from './Icon.astro';
import { dict, type Lang } from '../i18n';
import { CATEGORY } from '../i18n/vocab';
import type { Facets } from '../lib/facets';

interface Props {
  lang: Lang;
  facets: Facets;
  action: string;
  /** Hide the deal control on pages that are already a single deal. */
  showDeal?: boolean;
}
const { lang, facets, action, showDeal = true } = Astro.props;
const t = dict(lang);
---

<div class="filters-shell">
  <button class="btn btn-outline filters-open" type="button" data-filters-open aria-expanded="false" aria-controls="filters">
    <Icon name="sliders-horizontal" size={18} />
    {t.filters.open}
  </button>

  <form class="filters" id="filters" method="get" action={action} data-filters>
    <div class="filters-head">
      <h2>{t.filters.title}</h2>
      <button class="filters-close" type="button" data-filters-close>
        <Icon name="x" size={20} />
        <span class="sr-only">{t.filters.close}</span>
      </button>
    </div>

    <div class="filters-body">
      {
        showDeal && facets.deals.length > 1 && (
          <p class="field">
            <label for="f-deal">{t.filters.deal}</label>
            <select id="f-deal" name="deal">
              <option value="">{t.filters.any}</option>
              <option value="sale">{t.search.sale}</option>
              <option value="rent">{t.search.rent}</option>
            </select>
          </p>
        )
      }

      {
        facets.categories.length > 1 && (
          <p class="field">
            <label for="f-category">{t.filters.category}</label>
            <select id="f-category" name="category">
              <option value="">{t.filters.any}</option>
              {facets.categories.map((c) => (
                <option value={c}>{CATEGORY[c as keyof typeof CATEGORY].label[lang]}</option>
              ))}
            </select>
          </p>
        )
      }

      {
        facets.cities.length > 1 && (
          <p class="field">
            <label for="f-city">{t.filters.city}</label>
            <select id="f-city" name="city">
              <option value="">{t.filters.any}</option>
              {facets.cities.map((c) => (
                <option value={c}>{c}</option>
              ))}
            </select>
          </p>
        )
      }

      {
        facets.neighbourhoods.length > 1 && (
          <p class="field">
            <label for="f-hood">{t.filters.neighbourhood}</label>
            <select id="f-hood" name="hood">
              <option value="">{t.filters.any}</option>
              {facets.neighbourhoods.map((n) => (
                <option value={n}>{n}</option>
              ))}
            </select>
          </p>
        )
      }

      <fieldset class="field range">
        <legend>{t.filters.price}</legend>
        <span>
          <label class="sr-only" for="f-pmin">{t.filters.priceMin}</label>
          <input id="f-pmin" name="pmin" type="number" inputmode="numeric" min="0" step="1000" placeholder={t.filters.min} />
        </span>
        <span aria-hidden="true">–</span>
        <span>
          <label class="sr-only" for="f-pmax">{t.filters.priceMax}</label>
          <input id="f-pmax" name="pmax" type="number" inputmode="numeric" min="0" step="1000" placeholder={t.filters.max} />
        </span>
      </fieldset>

      <fieldset class="field range">
        <legend>{t.filters.size}</legend>
        <span>
          <label class="sr-only" for="f-smin">{t.filters.sizeMin}</label>
          <input id="f-smin" name="smin" type="number" inputmode="numeric" min="0" step="10" placeholder={t.filters.min} />
        </span>
        <span aria-hidden="true">–</span>
        <span>
          <label class="sr-only" for="f-smax">{t.filters.sizeMax}</label>
          <input id="f-smax" name="smax" type="number" inputmode="numeric" min="0" step="10" placeholder={t.filters.max} />
        </span>
      </fieldset>

      {
        facets.bedrooms.length > 0 && (
          <p class="field">
            <label for="f-beds">{t.filters.bedrooms}</label>
            <select id="f-beds" name="beds">
              <option value="">{t.filters.bedroomsAny}</option>
              {facets.bedrooms.map((n) => (
                <option value={String(n)}>{t.filters.bedroomsMin(n)}</option>
              ))}
            </select>
          </p>
        )
      }

      <div class="checks">
        {
          facets.hasFurnished && (
            <label class="check">
              <input type="checkbox" name="furnished" value="1" />
              <span>{t.filters.furnished}</span>
            </label>
          )
        }
        {
          facets.hasNewBuild && (
            <label class="check">
              <input type="checkbox" name="new" value="1" />
              <span>{t.filters.newBuild}</span>
            </label>
          )
        }
      </div>

      <p class="field">
        <label for="f-sort">{t.filters.sort}</label>
        <select id="f-sort" name="sort">
          <option value="newest">{t.filters.sortNewest}</option>
          <option value="price-asc">{t.filters.sortPriceAsc}</option>
          <option value="price-desc">{t.filters.sortPriceDesc}</option>
          <option value="size">{t.filters.sortSize}</option>
        </select>
      </p>
    </div>

    <div class="filters-foot">
      <button class="btn btn-primary filters-apply" type="submit" data-filters-apply>{t.filters.apply(0)}</button>
      <button class="btn btn-outline" type="button" data-filters-clear>{t.filters.clear}</button>
    </div>
  </form>
</div>

<style>
  .filters-open {
    display: none;
    width: 100%;
  }

  .filters {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    padding: var(--s-4);
  }
  .filters-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: var(--s-4);
  }
  .filters-head h2 {
    font-size: var(--step-1);
  }
  .filters-close {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-2);
  }

  .filters-body {
    display: grid;
    gap: var(--s-4);
  }
  .field {
    display: grid;
    gap: var(--s-1);
    margin: 0;
    border: 0;
    padding: 0;
    min-inline-size: 0;
  }
  .field label,
  .field legend {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
    padding: 0;
  }
  .field select,
  .field input {
    min-height: 44px;
    width: 100%;
    padding: 0 var(--s-3);
    border: 1px solid var(--line-control);
    border-radius: var(--r-2);
    background: var(--surface);
  }
  .range {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-2);
  }
  .range legend {
    grid-column: 1 / -1;
  }

  .checks {
    display: grid;
    gap: var(--s-2);
  }
  .check {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    font-size: var(--step-0);
    cursor: pointer;
  }
  .check input {
    width: 20px;
    height: 20px;
    accent-color: var(--green-500);
  }

  .filters-foot {
    display: grid;
    gap: var(--s-2);
    margin-block-start: var(--s-5);
  }
  /* With JS the list updates live, so "Show N" is only the sheet's close action on mobile. */
  :global(html.js) .filters-apply {
    display: none;
  }

  @media (max-width: 899px) {
    .filters-open {
      display: inline-flex;
    }
    :global(html.js) .filters {
      display: none;
    }
    :global(html.js) .filters.is-open {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 60;
      border-radius: 0;
      border: 0;
      overflow-y: auto;
      padding: var(--s-4) var(--gutter) calc(var(--s-5) + env(safe-area-inset-bottom));
      overscroll-behavior: contain;
    }
    :global(html.js) .filters.is-open .filters-close {
      display: inline-flex;
    }
    :global(html.js) .filters.is-open .filters-apply {
      display: inline-flex;
      position: sticky;
      inset-block-end: 0;
    }
    :global(html.js) .filters.is-open .filters-foot {
      position: sticky;
      inset-block-end: 0;
      background: var(--surface);
      padding-block-start: var(--s-3);
    }
  }
</style>
