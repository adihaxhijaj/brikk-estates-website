---
import BaseLayout from '../layouts/BaseLayout.astro';
import SymbolGraphic from '../components/SymbolGraphic.astro';
import ContactStrip from '../components/ContactStrip.astro';
import { dict, route, ROUTES, type Lang } from '../i18n';
import { getVisibleListings } from '../lib/listings';
import { NEIGHBOURHOODS } from '../../scripts/lib/parse-listing';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
const a = t.about;
const listings = await getVisibleListings();

// "Where we work": neighbourhoods that appear in the published listings, grouped by city, each linking to the filtered list.
const cities = ['Prishtinë', 'Fushë Kosovë'];
const groups = cities.map((city) => {
  const hoods = [...new Set(listings.filter((l) => l.city === city && l.neighbourhood).map((l) => l.neighbourhood!))].sort((x, y) => x.localeCompare(y, 'sq'));
  const cityEn = listings.find((l) => l.city === city)?.cityEn ?? city;
  return { city, label: lang === 'en' ? cityEn : city, hoods };
});
const elsewhere = [...new Set(listings.filter((l) => l.city && !cities.includes(l.city)).map((l) => (lang === 'en' ? l.cityEn : l.city)!))];
const hoodName = (n: string) => (lang === 'en' ? NEIGHBOURHOODS.find((h) => h.name === n)?.en ?? n : n);
const base = route('properties', lang);
---
<BaseLayout lang={lang} title={a.metaTitle} description={a.metaDescription} alternates={ROUTES.about}>
  <section class="about-hero surface-green on-dark">
    <SymbolGraphic class="about-hero__symbol" />
    <div class="container about-hero__inner">
      <h1>{a.h1}</h1>
      <p class="about-hero__line">{t.tagline}</p>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div class="prose about-text">
        {a.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <aside class="mission" aria-labelledby="mission-title">
        <h2 id="mission-title" class="eyebrow">{a.missionTitle}</h2>
        {a.mission.map((m) => <p class="mission__quote">{m}</p>)}
      </aside>
    </div>
  </section>

  <section class="section surface-white" aria-labelledby="values-title">
    <div class="container">
      <h2 id="values-title" class="section-head">{a.valuesTitle}</h2>
      <ul role="list" class="values">
        {a.values.map((v) => (
          <li><h3>{v.title}</h3><p>{v.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="where-title">
    <div class="container">
      <h2 id="where-title">{a.whereTitle}</h2>
      <p class="where-intro">{a.whereIntro}</p>
      <div class="where">
        {groups.map((g) => (
          <div>
            <h3><a href={`${base}?city=${encodeURIComponent(g.city)}`}>{g.label}</a></h3>
            <ul role="list" class="chips">
              {g.hoods.map((h) => <li><a class="chip" href={`${base}?city=${encodeURIComponent(g.city)}&hood=${encodeURIComponent(h)}`}>{hoodName(h)}</a></li>)}
            </ul>
          </div>
        ))}
        {elsewhere.length > 0 && (
          <div>
            <h3>{a.alsoTitle}</h3>
            <ul role="list" class="chips">
              {listings.filter((l) => l.city && !cities.includes(l.city)).reduce((acc, l) => (acc.some((x) => x.city === l.city) ? acc : [...acc, l]), [] as typeof listings).map((l) => (
                <li><a class="chip" href={`${base}?city=${encodeURIComponent(l.city!)}`}>{lang === 'en' ? l.cityEn : l.city}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="identity surface-green on-dark">
    <div class="container"><p class="identity__line">{a.identity}</p></div>
  </section>

  <ContactStrip lang={lang} title={t.home.contactTitle} />
</BaseLayout>

<style>
  .about-hero { position: relative; overflow: hidden; isolation: isolate; }
  .about-hero__inner { padding-block: clamp(3rem, 2rem + 5vw, 6rem); display: grid; gap: var(--s-4); }
  .about-hero h1 { font-size: var(--fs-2xl); color: var(--cream); line-height: 1.04; max-width: 14ch; }
  .about-hero__line { font-size: var(--fs-md); color: var(--leaf); font-weight: 600; }
  .about-hero__symbol { position: absolute; z-index: -1; width: 26rem; right: -8rem; top: 50%; translate: 0 -50%; }
  @media (max-width: 47.99rem) { .about-hero__symbol { width: 13rem; right: -6.5rem; top: 1rem; translate: none; } }
  .about-grid { display: grid; gap: var(--s-7); }
  @media (min-width: 62rem) { .about-grid { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); } }
  .about-text { font-size: var(--fs-md); }
  .mission { display: grid; gap: var(--s-4); align-content: start; padding: var(--s-5); border-left: 3px solid var(--green); background: var(--cream-soft); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; }
  .mission h2 { color: var(--green-ink); font-size: var(--fs-sm); }
  .mission__quote { font-size: var(--fs-lg); font-weight: 700; font-stretch: var(--wide); line-height: 1.25; color: var(--green-ink); }
  .values { display: grid; gap: var(--s-5) var(--s-6); grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  .values li { display: grid; gap: var(--s-2); padding-top: var(--s-3); border-top: 1px solid var(--line); }
  .values p { color: var(--ink-2); }
  .where-intro { margin-top: var(--s-2); color: var(--ink-2); }
  .where { display: grid; gap: var(--s-6); margin-top: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .where h3 { margin-bottom: var(--s-3); }
  .where h3 a { color: var(--ink); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .chip { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--s-3); border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--white); color: var(--ink); text-decoration: none; font-weight: 550; }
  a.chip:hover { border-color: var(--green); background: var(--tint); }
  .chip--plain { color: var(--ink-2); background: transparent; border-style: dashed; }
  .identity { padding-block: var(--s-7); }
  .identity__line { font-size: var(--fs-xl); font-weight: 780; font-stretch: var(--wide); color: var(--cream); line-height: 1.1; max-width: 24ch; }
</style>
