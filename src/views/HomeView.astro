---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/SearchPanel.astro';
import SymbolGraphic from '../components/SymbolGraphic.astro';
import ListingCard from '../components/ListingCard.astro';
import ContactStrip from '../components/ContactStrip.astro';
import Icon from '../components/Icon.astro';
import { CATEGORY } from '../i18n/vocab';
import { dict, route, ROUTES, type Lang } from '../i18n';
import { categoryOf, getVisibleListings } from '../lib/listings';
import { agentJsonLd } from '../lib/seo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
const listings = await getVisibleListings();
const latest = listings.slice(0, 8);
const cats = (Object.keys(CATEGORY) as (keyof typeof CATEGORY)[]).map((k) => ({
  key: k,
  label: CATEGORY[k].label[lang],
  count: listings.filter((l) => categoryOf(l) === k).length,
  href: `${route('properties', lang)}?cat=${k}`,
})).filter((c) => c.count > 0);
const catIcons: Record<string, string> = { apartments: 'building-2', houses: 'house', land: 'land-plot', commercial: 'store' };
---
<BaseLayout lang={lang} title={t.meta.homeTitle} description={t.meta.homeDescription} alternates={ROUTES.home} jsonLd={agentJsonLd(lang)} brandMoment>
  <section class="hero surface-green on-dark">
    <SymbolGraphic class="hero__symbol" animate />
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow">{t.home.eyebrow}</p>
        <h1 class="hero__title">{t.home.h1}</h1>
        <p class="hero__support">{t.home.support}</p>
      </div>
      <div class="hero__search">
        <SearchPanel lang={lang} listings={listings} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="latest-title">
    <div class="container">
      <div class="section-head">
        <h2 id="latest-title">{t.home.latestTitle}</h2>
        <a class="btn btn--outline" href={route('properties', lang)}>{t.home.viewAll}<Icon name="arrow-right" /></a>
      </div>
      <ul role="list" class="grid">
        {latest.map((l, i) => <li><ListingCard listing={l} lang={lang} eager={i < 2} /></li>)}
      </ul>
      <p class="availability-note home-note">{t.listings.availability}</p>
    </div>
  </section>

  <section class="section surface-white categories" aria-labelledby="cat-title">
    <div class="container">
      <h2 id="cat-title" class="section-head">{t.home.categoriesTitle}</h2>
      <ul role="list" class="cats">
        {cats.map((c) => (
          <li>
            <a class="cat" href={c.href}>
              <Icon name={catIcons[c.key]} size={28} />
              <span class="cat__label">{c.label}</span>
              <span class="cat__count tabular">{t.home.propertiesCount(c.count)}</span>
              <Icon name="arrow-right" size={20} class="cat__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="why-title">
    <div class="container why">
      <h2 id="why-title" class="why__title">{t.home.whyTitle}</h2>
      <ul role="list" class="why__list">
        {t.home.why.map((w, i) => (
          <li class="why__item">
            <span class="why__num tabular" aria-hidden="true">0{i + 1}</span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="owners-band surface-green on-dark" aria-labelledby="owners-title">
    <SymbolGraphic class="owners-band__symbol" />
    <div class="container owners-band__inner">
      <h2 id="owners-title" class="owners-band__title">{t.home.ownersTitle}</h2>
      <p class="owners-band__text">{t.home.ownersText}</p>
      <a class="btn btn--cream" href={route('owners', lang)}>{t.home.ownersCta}<Icon name="arrow-right" /></a>
    </div>
  </section>

  <ContactStrip lang={lang} title={t.home.contactTitle} />
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; isolation: isolate; }
  .hero__inner { position: relative; display: grid; gap: var(--s-6); padding-block: clamp(2.5rem, 2rem + 4vw, 6rem) clamp(2.5rem, 2rem + 3vw, 5rem); }
  .hero__copy { max-width: 46rem; }
  .hero__eyebrow { color: var(--leaf); margin-bottom: var(--s-4); }
  .hero__title { font-size: var(--fs-2xl); font-weight: 780; font-stretch: var(--wide); line-height: 1.04; letter-spacing: -0.02em; color: var(--cream); }
  .hero__support { margin-top: var(--s-5); font-size: var(--fs-md); max-width: 38ch; color: var(--cream); }
  .hero__symbol { position: absolute; z-index: -1; width: min(34rem, 80vw); right: -14%; top: -12%; }
  @media (max-width: 47.99rem) {
    .hero__symbol { width: 15rem; right: -6.5rem; top: -4.5rem; opacity: 1; }
    .hero__copy { padding-right: 3.5rem; }
  }
  @media (min-width: 75rem) {
    .hero__symbol { right: -6%; top: 50%; translate: 0 -54%; width: 36rem; }
    .hero__copy { max-width: 52rem; padding-right: 20rem; }
    .hero__search { max-width: 64rem; }
  }

  .grid { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 17.5rem), 1fr)); }
  .home-note { margin-top: var(--s-5); }

  .cats { display: grid; gap: var(--s-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .cat {
    display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: 'icon label arrow' 'icon count arrow'; column-gap: var(--s-4); align-items: center;
    padding: var(--s-5); min-height: 6rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--paper);
    color: var(--ink); text-decoration: none; transition: border-color var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease);
  }
  .cat:hover { border-color: var(--green); background: var(--tint); }
  .cat > :global(svg:first-child) { grid-area: icon; color: var(--green); }
  .cat__label { grid-area: label; font-weight: 700; font-stretch: var(--wide); font-size: var(--fs-md); line-height: 1.2; }
  .cat__count { grid-area: count; color: var(--muted); font-size: var(--fs-sm); }
  .cat :global(.cat__arrow) { grid-area: arrow; color: var(--green); }

  .why { display: grid; gap: var(--s-6); }
  .why__list { display: grid; gap: var(--s-6) var(--s-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .why__item { border-top: 2px solid var(--green); padding-top: var(--s-4); }
  .why__num { display: block; color: var(--muted); font-size: var(--fs-sm); font-weight: 600; margin-bottom: var(--s-3); }
  .why__item h3 { margin-bottom: var(--s-2); }
  .why__item p { color: var(--ink-2); }
  @media (min-width: 62rem) { .why { grid-template-columns: 1fr 3fr; } }

  .owners-band { position: relative; overflow: hidden; isolation: isolate; padding-block: var(--section); }
  .owners-band__inner { display: grid; gap: var(--s-5); justify-items: start; max-width: calc(46rem + 2 * var(--gutter)); margin-left: 0; }
  @media (min-width: 75rem) { .owners-band__inner { margin-left: max(0px, calc((100vw - var(--max)) / 2 - var(--gutter))); } }
  .owners-band__title { font-size: var(--fs-xl); font-weight: 780; color: var(--cream); line-height: 1.08; }
  .owners-band__text { font-size: var(--fs-md); max-width: 44ch; }
  .owners-band__symbol { position: absolute; z-index: -1; width: 30rem; right: -12rem; bottom: -9rem; }
  @media (max-width: 47.99rem) { .owners-band__symbol { width: 16rem; right: -8rem; bottom: -7rem; } }
</style>
